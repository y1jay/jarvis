    "sherpa-onnx-node": "^2.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "npm run assets && node scripts/electron-vite.mjs dev",
    "build": "npm run assets && electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "e2e": "npm run build && node tests/e2e/run.mjs",
    "dist:mac": "npm run build && node scripts/build-whisper.mjs && electron-builder --mac",
    "dist:win": "npm run build && node scripts/build-whisper.mjs && electron-builder --win",
    "icons": "node scripts/run-electron.mjs scripts/make-icon.mjs",
    "whisper": "node scripts/build-whisper.mjs"
  }
